    {
      "id": "PRION-HARD-092",
      "title": "Hermetia déclarée comme source, équarrissage direct, méthode 1 prouvée -> volailles : substrat des insectes non contrôlé",
      "op": "evaluate",
      "input": {
        "batch_id": "AT-L-01",
        "substrate": {
          "category": 3,
          "material_class": "slaughter_byproduct",
          "origin_profile": "farm",
          "sources": [
            {
              "taxid": 343691
            }
          ]
        },
        "process": {
          "route": "direct_rendering",
          "treatment": {
            "method": 1,
            "core_temp_c": 133,
            "pressure_bar": 3,
            "minutes": 20,
            "evidence_sha256": "04ebcf825943a6163a6287e4880066f027534c52f437af73d231cb6ed4b61e79"
          }
        },
        "product": "PAP",
        "destination": {
          "use": "feed",
          "target_taxids": [
            9031
          ]
        }
      },
      "expect": {
        "verdict": "BLOCKED",
        "reasons": [
          "SUBSTRATE_CATEGORY_VIOLATION"
        ],
        "signature_permitted": false
      },
      "rule": "README §4.12 P18 : en alimentation, les insectes n'entrent que par la route insect_bioconversion, seule route où leur substrat est contrôlé ; un insecte déclaré dans `sources` vaut SUBSTRATE_CATEGORY_VIOLATION et la nature « insecte » de P6 est réservée à cette route",
      "tags": [
        "p18",
        "safety"
