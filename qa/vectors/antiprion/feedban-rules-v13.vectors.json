  "adapter": "antiprion.feedban",
  "description": "Règle P14 de la Porte de Fer, issue de l'audit du code livré au cycle 0004 : l'organisme de bioconversion doit être un insecte. Sans elle, un bovin ou un être humain déclaré comme « insecte » produisait une PAT classée INSECT et autorisée vers les volailles.",
  "cases": [
    {
      "id": "PRION-HARD-063",
      "title": "Bovin déclaré comme insecte de bioconversion -> PAT « d'insecte » -> volailles",
      "op": "evaluate",
      "input": {
        "batch_id": "AT-K-01",
        "substrate": {
          "category": 3,
          "material_class": "feed_grade_plant",
          "origin_profile": "feed_industry",
          "sources": []
        },
        "process": {
          "route": "insect_bioconversion",
          "treatment": {
            "method": 7,
            "evidence_sha256": "a30eacf43cc36e722b1c5e63520bca7dd3d7dc47af07f1b24675acf612f16d23"
          },
          "insect_taxid": 9913
        },
        "product": "insect_PAP",
        "destination": {
          "use": "feed",
          "target_taxids": [
            9031
          ]
        }
      },
      "expect": {
        "verdict": "BLOCKED",
        "reasons": [
          "TAXON_UNKNOWN"
        ],
        "signature_permitted": false
      },
      "rule": "README §4.6 P14 : en bioconversion, `insect_taxid` doit se résoudre en une espèce du groupe INSECT du snapshot ; tout autre organisme vaut TAXON_UNKNOWN et n'entre pas dans les sources (un mammifère déclaré « insecte » ne devient pas une PAT d'insecte)",
      "tags": [
        "p14",
        "safety",
        "ruminant"
      ]
    },
