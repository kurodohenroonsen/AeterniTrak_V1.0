      "op": "canonicalize",
      "input": {
        "b": 1,
        "a": 2
      },
      "expect": {
        "utf8": "{\"a\":2,\"b\":1}",
        "hex": "7b2261223a322c2262223a317d",
        "len": 13,
        "sha256": "d3626ac30a87e6f7a6428233b3c68299976865fa5508e4267c5415c76af7a772"
